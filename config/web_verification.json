  "max_candidate_path_depth": 1,
  "max_candidate_path_depth_note": "An official website is found at its own root, or one level in. A mention of a brand on somebody else's site is deep-linked. This catches press and trade titles that are not on the list above, which can never be exhaustive.",
  "signal_weights": {
    "company_number_match": 4,
    "company_name_match": 3,
    "exact_domain_brand_match": 3,
    "location_match": 2,
    "third_party_corroboration": 2,
    "brand_in_title": 1,
    "partial_domain_brand_match": 1,
    "sector_match": 1,
    "multiple_pages_same_domain": 1
  },
  "entity_tie_signals": [
    "company_number_match",
    "company_name_match",
    "location_match",
    "third_party_corroboration"
  ],
  "brand_link_signals": [
    "exact_domain_brand_match",
    "partial_domain_brand_match",
    "brand_in_title"
  ],
  "brand_link_note": "A website published as a brand's own must carry that brand somewhere -- in the domain, or in a page title. Location, sector and a fragment of the registered name corroborate a domain; they can never be the only thing connecting it to the brand, or a company registered in Birmingham verifies 'Spirit of Birmingham'.",
  "verified_min_weight": 4,
  "probable_min_weight": 3,
  "verification_note": "VERIFIED needs enough weight AND a tie to the actual legal entity -- or, for a brand name distinctive enough that a domain match is not a coincidence, an exact domain match corroborated by the right sector. A name match on its own is never enough, because generic brand names collide with unrelated companies.",
  "distinctive_single_token_min_length": 8,
  "distinctiveness_note": "A multi-word brand, or a long single word, is unlikely to be shared by an unrelated company, so a domain match carries real evidential weight. A short or common single word is not: 'verified' there requires evidence about the company itself.",
