  "product_relevant_min_evidence": 4,
  "product_must_exceed_service_by": 1,
  "class_43_note": "Class 43 contributes one point of service evidence and never more. Genuine packaged-food filings routinely include it to cover a concept store or a stall, and plain restaurants routinely omit it.",
  "incidental_food": {
    "_note": "A handful of food lines does not make a cookware, homeware or media brand a food opportunity. The test is whether packaged food is a substantial part of the filing -- not whether any non-food class exists, because real food brands protect merchandise too.",
    "non_food_dominant_share": 0.5,
    "min_food_items_to_survive_without_food_sic": 12,
    "note": "Where non-food goods dominate the filing AND Companies House shows no food manufacturing or food trade activity, the food lines are treated as incidental and the record is suppressed. A company registered to make or trade food keeps its merchandise classes, because for it they are ordinary brand protection."
  },
  "delivered_modes": [
    "packaged_product",
    "mixed_but_product_relevant"
  ],
  "delivery_note": "Only modes that establish packaged-product relevance reach a paying customer. FOOD_SERVICE, NON_PRODUCT and UNCERTAIN are held back: where relevance cannot be established, withholding beats presenting speculation as a sales opportunity.",
  "web_hospitality_note": "Terms that separate a place people eat at from a business that makes packaged food. A hygiene rating is not one of them: manufacturers, wholesalers and cafes all have one."
