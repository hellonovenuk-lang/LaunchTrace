    "max_company_age_years_for_emerging": 6.0,
    "ideal_max_company_age_years": 3.0,
    "note": "Company age is measured at trade mark filing date, so historical validation and live weekly runs use the same rule.",
    "max_months_incorporated_after_filing": 6,
    "incorporated_after_filing_note": "A company incorporated shortly AFTER the trade mark was filed is a normal launch pattern (protect the name, then incorporate). Beyond this many months it is almost certainly a different company that happens to share the name, so the match is discarded rather than used."
