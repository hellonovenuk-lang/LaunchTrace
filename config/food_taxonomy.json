    29,
    30
  ],
  "supporting_nice_classes": [
    31,
    32,
    33
  ],
  "context_only_nice_classes": [
    5,
    35,
    39,
    40,
    43
  ],
  "notes": {
    "primary_nice_classes": "Classes that on their own make a record a food candidate (29 = meat/dairy/preserved foods, 30 = staple foods, snacks, confectionery, bakery).",
    "supporting_nice_classes": "Only counted when combined with a primary class or a strong packaged-food keyword. 31 is largely raw agricultural produce, 32/33 are drinks (out of scope for v1 but retained as supporting evidence of an FMCG brand).",
    "context_only_nice_classes": "Never qualify a record on their own. Used as context (for example class 43 alone means restaurant/catering services, not a packaged product)."
  },
