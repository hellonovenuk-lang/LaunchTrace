# Local working data — never commit large source dumps or caches.
var/
data/cache/
data/companies_house/*.zip
data/companies_house/*.csv
data/companies_house/*.sqlite
data/raw/
*.sqlite
*.sqlite3
*.db
reports/local/
reports/runs/
reports/smoke/
reports/outbox/
# Generated sales working files. Every one is reproducible from a command, and
# they contain prospect names and lead data that has no reason to be in git.
reports/previews/
reports/samples/
reports/outreach_drafts/
reports/backups/

# Live outreach state and the suppression list are in the application
# database, never in git. Exports of them, from `python -m src.admin backup`,
# land in reports/backups/ which is already ignored above.
outreach/backups/
