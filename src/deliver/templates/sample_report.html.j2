<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>{{ title }}</title>
<style>
  :root { color-scheme: light; }
  body { margin:0; background:#f5f5f4; color:#1c1917;
         font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; }
  .wrap { max-width:860px; margin:0 auto; padding:32px 20px 64px; }
  .eyebrow { font-size:12px; letter-spacing:.10em; text-transform:uppercase; color:#78716c; margin:0 0 6px; }
  h1 { font-size:24px; font-weight:600; margin:0 0 8px; }
  .lede { font-size:15px; line-height:1.65; color:#44403c; max-width:64ch; }
  .banner { display:inline-block; margin:0 0 20px; padding:6px 12px; border-radius:4px;
            background:#fef3c7; border:1px solid #fcd34d; color:#78350f;
            font-size:12px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; }
  .meta { display:flex; flex-wrap:wrap; gap:16px; margin:20px 0 28px; padding:14px 16px;
          background:#fff; border:1px solid #e7e5e4; border-radius:6px; font-size:13px; }
  .meta div { min-width:120px; }
  .meta span { display:block; color:#78716c; font-size:11px; text-transform:uppercase;
               letter-spacing:.06em; margin-bottom:2px; }
  .lead { background:#fff; border:1px solid #e7e5e4; border-radius:6px;
          padding:18px 20px; margin:0 0 14px; }
  .lead-head { display:flex; justify-content:space-between; align-items:baseline; gap:12px;
               flex-wrap:wrap; margin-bottom:4px; }
  .brand { font-size:17px; font-weight:600; margin:0; }
  .score { font-size:13px; font-weight:600; white-space:nowrap; }
  .score .band { display:inline-block; padding:2px 8px; border-radius:3px; margin-left:6px;
                 font-size:11px; letter-spacing:.05em; }
  .band-HIGH { background:#dcfce7; color:#14532d; }
  .band-MEDIUM { background:#e0f2fe; color:#075985; }
  .sub { font-size:13px; color:#57534e; margin:0 0 12px; }
  .row { font-size:13.5px; line-height:1.6; margin:0 0 6px; }
  .row b { font-weight:600; color:#292524; }
  .why { margin:10px 0 0; padding-left:18px; font-size:13.5px; line-height:1.6; color:#44403c; }
  .why li { margin-bottom:3px; }
  .tags { margin-top:12px; display:flex; flex-wrap:wrap; gap:6px; }
  .tag { font-size:11.5px; padding:3px 9px; border-radius:99px; border:1px solid #e7e5e4;
         background:#fafaf9; color:#44403c; }
  .tag.h { border-color:#86efac; background:#f0fdf4; color:#14532d; }
  a { color:#0369a1; }
  .note { margin-top:32px; padding:16px 18px; background:#fff; border:1px solid #e7e5e4;
          border-radius:6px; font-size:13px; line-height:1.65; color:#57534e; }
  .note b { color:#292524; }
  .footer { margin-top:24px; font-size:12px; line-height:1.6; color:#78716c; }
  .empty { background:#fff; border:1px solid #e7e5e4; border-radius:6px; padding:24px;
           font-size:14px; color:#57534e; }
  table.summary { border-collapse:collapse; width:100%; font-size:13px; margin-top:8px; }
  table.summary th, table.summary td { text-align:left; padding:6px 10px; border-bottom:1px solid #e7e5e4; }
  table.summary th { color:#78716c; font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.05em; }
</style>
</head>
<body>
<div class="wrap">
  {% if watermark %}<div class="banner">Sample — not a live subscription</div>{% endif %}
  <p class="eyebrow">LaunchTrace Food</p>
  <h1>{{ title }}</h1>
  <p class="lede">{{ intro }}</p>

  <div class="meta">
    <div><span>Opportunities</span>{{ leads|length }}</div>
    <div><span>Strongest band</span>{{ high_count }} HIGH · {{ medium_count }} MEDIUM</div>
    <div><span>Journal week{{ 's' if journals|length > 1 else '' }}</span>{{ journals|join(', ') }}</div>
    <div><span>Prepared</span>{{ prepared_on }}</div>
    {% if supplier_label %}<div><span>Prepared for</span>{{ supplier_label }}</div>{% endif %}
  </div>

  {% if not leads %}
    <div class="empty">
      No opportunities cleared the qualification thresholds for this sample. Nothing has
      been hidden — the feed simply had nothing worth a sales team's time.
    </div>
  {% endif %}

  {% for item in leads %}
  <div class="lead">
    <div class="lead-head">
      <p class="brand">{{ loop.index }}. {{ item.brand or item.trademark_number }}</p>
      <p class="score">LaunchTrace Score {{ item.score }}<span class="band band-{{ item.band }}">{{ item.band }}</span></p>
    </div>
    <p class="sub">{{ item.category or 'Packaged food' }}{% if item.region %} · {{ item.region }}{% endif %}</p>

    <p class="row"><b>Company:</b> {{ item.company }}{% if item.company_number %} (registered {{ item.company_number }}){% endif %}{% if item.incorporated %} · incorporated {{ item.incorporated }}{% endif %}</p>
    {% if item.goods %}<p class="row"><b>Goods:</b> {{ item.goods }}</p>{% endif %}
    {% if item.website %}<p class="row"><b>Website:</b> <a href="{{ item.website }}">{{ item.website }}</a></p>{% endif %}
    <p class="row"><b>Stage indicated:</b> {{ item.stage }}</p>

    {% if item.reasons %}
    <p class="row" style="margin-top:12px"><b>Why this was selected</b></p>
    <ul class="why">
      {% for reason in item.reasons %}<li>{{ reason }}</li>{% endfor %}
    </ul>
    {% endif %}

    {% if item.intents %}
    <div class="tags">
      {% for tag in item.intents %}<span class="tag{% if tag.endswith('HIGH') %} h{% endif %}">{{ tag }}</span>{% endfor %}
    </div>
    {% endif %}

    {% if item.source_url %}
    <p class="row" style="margin-top:12px"><b>Source:</b> <a href="{{ item.source_url }}">{{ item.source_url }}</a></p>
    {% endif %}
  </div>
  {% endfor %}

  <div class="note">
    <p style="margin-top:0"><b>What these are.</b> Commercial signals derived from newly
    published UK trade mark activity, matched to Companies House records and scored on how
    early-stage the brand appears. Each entry means a brand exists and has protected its
    name — not that it has placed an order or intends to.</p>
    <p><b>Relevance bands.</b> The tags indicate what a brand at this stage typically needs.
    They are inferred relevance, never a statement that the company is currently buying.</p>
    <p style="margin-bottom:0"><b>Disagree with any of it.</b> Every entry shows the reasons
    behind its score, so you can judge each one yourself. That is the point of publishing
    the reasoning rather than just the number.</p>
  </div>

  <p class="footer">
    Sources: UK Intellectual Property Office and Companies House data, used under the
    Open Government Licence v3.0.{% if site_url %} {{ site_url }}{% endif %}
    {% if unsubscribe_url %}<br><a href="{{ unsubscribe_url }}">Opt out of LaunchTrace email</a>.{% endif %}
  </p>
</div>
</body></html>
