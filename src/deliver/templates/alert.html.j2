<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>LaunchTrace pipeline alert</title></head>
<body style="margin:0;background:#f5f5f4;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1c1917;">
<div style="max-width:640px;margin:0 auto;padding:24px 16px;">
  <p style="margin:0 0 4px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#b91c1c;">LaunchTrace pipeline alert</p>
  <h1 style="margin:0 0 16px;font-size:20px;font-weight:600;">{{ title }}</h1>
  <table role="presentation" style="width:100%;border-collapse:collapse;background:#fff;border:1px solid #e7e5e4;border-radius:6px;">
    <tr><td style="padding:12px 16px;font-size:14px;border-bottom:1px solid #f5f5f4;">Run</td><td style="padding:12px 16px;font-size:14px;border-bottom:1px solid #f5f5f4;text-align:right;">{{ run_id }}</td></tr>
    <tr><td style="padding:12px 16px;font-size:14px;border-bottom:1px solid #f5f5f4;">Journal</td><td style="padding:12px 16px;font-size:14px;border-bottom:1px solid #f5f5f4;text-align:right;">{{ journal_number }}</td></tr>
    <tr><td style="padding:12px 16px;font-size:14px;">Status</td><td style="padding:12px 16px;font-size:14px;text-align:right;"><strong>{{ status }}</strong></td></tr>
  </table>
  <h2 style="font-size:15px;margin:20px 0 8px;">What happened</h2>
  <pre style="background:#fff;border:1px solid #e7e5e4;border-radius:6px;padding:12px;font-size:12px;white-space:pre-wrap;">{{ detail }}</pre>
  <p style="font-size:13px;color:#57534e;">No customer email was sent for this run.</p>
</div></body></html>
