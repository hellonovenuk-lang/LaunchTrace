<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f5f5f4;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1c1917;">
<div style="max-width:640px;margin:0 auto;padding:24px 16px;">

  <p style="margin:0 0 4px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#78716c;">LaunchTrace Food</p>
  <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:600;">{{ subject }}</h1>

  <p style="margin:0 0 16px;font-size:15px;line-height:1.6;">
    {{ intro }}
  </p>

  <table role="presentation" style="width:100%;border-collapse:collapse;margin:0 0 24px;background:#fff;border:1px solid #e7e5e4;border-radius:6px;">
    <tr>
      <td style="padding:14px 16px;font-size:14px;border-bottom:1px solid #f5f5f4;">Journal week</td>
      <td style="padding:14px 16px;font-size:14px;border-bottom:1px solid #f5f5f4;text-align:right;"><strong>{{ publication_date }}</strong> (journal {{ journal_number }})</td>
    </tr>
    <tr>
      <td style="padding:14px 16px;font-size:14px;border-bottom:1px solid #f5f5f4;">Opportunities in this feed</td>
      <td style="padding:14px 16px;font-size:14px;border-bottom:1px solid #f5f5f4;text-align:right;"><strong>{{ total }}</strong></td>
    </tr>
    <tr>
      <td style="padding:14px 16px;font-size:14px;">Strongest signals (HIGH band)</td>
      <td style="padding:14px 16px;font-size:14px;text-align:right;"><strong>{{ high_count }}</strong></td>
    </tr>
  </table>

  <h2 style="margin:0 0 12px;font-size:16px;font-weight:600;">Top {{ top|length }} this week</h2>

  {% for opp in top %}
  <div style="background:#fff;border:1px solid #e7e5e4;border-radius:6px;padding:16px;margin:0 0 12px;">
    <div style="display:block;margin:0 0 6px;">
      <span style="font-size:16px;font-weight:600;">{{ opp.brand_name or opp.trademark_number }}</span>
      <span style="display:inline-block;margin-left:8px;padding:2px 8px;border-radius:10px;font-size:12px;font-weight:600;background:{{ '#dcfce7' if opp.score.band.value == 'HIGH' else '#fef3c7' }};color:{{ '#166534' if opp.score.band.value == 'HIGH' else '#854d0e' }};">{{ opp.score.value }} {{ opp.score.band.value }}</span>
    </div>
    <p style="margin:0 0 8px;font-size:14px;color:#57534e;">
      {% if opp.product_category_label %}{{ opp.product_category_label }} · {% endif %}
      {% if opp.company.company_name %}{{ opp.company.company_name }}{% else %}{{ opp.applicant_name }}{% endif %}
      {% if opp.company.region %} · {{ opp.company.region }}{% endif %}
    </p>
    <ul style="margin:0 0 10px;padding-left:18px;font-size:13px;line-height:1.6;color:#44403c;">
      {% for reason in opp.score.reason_texts[:3] %}<li>{{ reason }}</li>{% endfor %}
    </ul>
    <p style="margin:0;font-size:12px;color:#78716c;">
      Likely supplier needs:
      {% for label, band in top_intents(opp) %}<strong>{{ label }}</strong> {{ band }}{% if not loop.last %} · {% endif %}{% endfor %}
    </p>
    <p style="margin:8px 0 0;font-size:12px;">
      <a href="{{ opp.source_url }}" style="color:#0369a1;">Trade mark {{ opp.trademark_number }}</a>
      {% if opp.web.website %} · <a href="{{ opp.web.website }}" style="color:#0369a1;">{{ opp.web.website }}</a>{% endif %}
    </p>
  </div>
  {% endfor %}

  <div style="background:#fff;border:1px solid #e7e5e4;border-radius:6px;padding:16px;margin:16px 0;">
    <p style="margin:0 0 8px;font-size:14px;font-weight:600;">Full list</p>
    <p style="margin:0;font-size:14px;line-height:1.6;">
      {% if csv_url %}
      <a href="{{ csv_url }}" style="color:#0369a1;">Download this week's CSV ({{ total }} rows)</a>
      {% else %}
      The full CSV for this week is attached to this email ({{ total }} rows).
      {% endif %}
    </p>
  </div>

  <p style="margin:16px 0 8px;font-size:12px;line-height:1.6;color:#78716c;">
    Scores are LaunchTrace's own early-stage opportunity signal, not a prediction that a company
    will buy. Supplier categories are shown as inferred relevance, not confirmed purchasing intent.
  </p>
  <p style="margin:0 0 8px;font-size:12px;line-height:1.6;color:#78716c;">
    Source: trade mark data from the UK Intellectual Property Office and company data from
    Companies House, both used under the Open Government Licence v3.0. LaunchTrace is not
    affiliated with either body and this feed is not legal advice.
  </p>
  <p style="margin:0;font-size:12px;color:#78716c;">
    {{ from_name }} · <a href="{{ manage_url }}" style="color:#78716c;">Manage or cancel your subscription</a>
  </p>

</div>
</body>
</html>
