<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f5f5f4;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1c1917;">
<div style="max-width:640px;margin:0 auto;padding:24px 16px;">

  <p style="margin:0 0 4px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#78716c;">LaunchTrace Food · Brands that moved</p>
  <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:600;">{{ subject }}</h1>

  <p style="margin:0 0 16px;font-size:15px;line-height:1.6;">
    LaunchTrace re-checks brands from recent weeks' feeds. These {{ total }} moved since {{ since }}:
    a website went live or opened a shop, or the company record changed. A brand that has just
    started trading is often a brand that is just starting to buy.
  </p>

  {% macro card(m) %}
  <div style="background:#fff;border:1px solid #e7e5e4;border-radius:6px;padding:16px;margin:0 0 12px;">
    <div style="display:block;margin:0 0 6px;">
      <span style="font-size:16px;font-weight:600;">{{ m.brand_name or m.brand_uid }}</span>
      {% if m.launched %}<span style="display:inline-block;margin-left:8px;padding:2px 8px;border-radius:10px;font-size:12px;font-weight:600;background:#dcfce7;color:#166534;">Launched</span>{% endif %}
    </div>
    <p style="margin:0 0 8px;font-size:14px;color:#57534e;">
      {{ m.party }}{% if m.category_label %} · {{ m.category_label }}{% endif %}{% if m.region %} · {{ m.region }}{% endif %}
    </p>
    <ul style="margin:0 0 8px;padding-left:18px;font-size:13px;line-height:1.6;color:#44403c;">
      {% for move in m.moves %}<li>{{ move.from_label }} &rarr; <strong>{{ move.to_label }}</strong> <span style="color:#78716c;">({{ move.detected_at.strftime('%-d %b') }})</span></li>{% endfor %}
    </ul>
    <p style="margin:0;font-size:12px;">
      {% if m.company_url %}<a href="{{ m.company_url }}" style="color:#0369a1;">Companies House {{ m.company_number }}</a>{% endif %}
      {% if m.website %} · <a href="{{ m.website }}" style="color:#0369a1;">{{ m.website }}</a>{% endif %}
    </p>
  </div>
  {% endmacro %}

  {% if up %}
  <h2 style="margin:0 0 12px;font-size:16px;font-weight:600;">Moved forward</h2>
  {% for m in up %}{{ card(m) }}{% endfor %}
  {% endif %}

  {% if down %}
  <h2 style="margin:16px 0 12px;font-size:16px;font-weight:600;">Stopped trading</h2>
  <p style="margin:0 0 12px;font-size:13px;color:#57534e;">Worth taking off your list.</p>
  {% for m in down %}{{ card(m) }}{% endfor %}
  {% endif %}

  {% if not up and not down %}
  <p style="margin:0 0 16px;font-size:14px;color:#57534e;">No tracked brand moved this week.</p>
  {% endif %}

  {% if hidden %}
  <p style="margin:0 0 16px;font-size:13px;color:#57534e;">And {{ hidden }} more not shown here.</p>
  {% endif %}

  <p style="margin:16px 0 8px;font-size:12px;line-height:1.6;color:#78716c;">
    These are changes LaunchTrace observed on public websites and the Companies House register,
    not confirmed purchasing intent. Only companies are listed; individual applicants never are.
  </p>
  <p style="margin:0 0 8px;font-size:12px;line-height:1.6;color:#78716c;">
    Source: company data from Companies House under the Open Government Licence v3.0, and
    public domain-registration (RDAP), DNS and website checks. LaunchTrace is not affiliated
    with Companies House.
  </p>
  <p style="margin:0;font-size:12px;color:#78716c;">
    {{ from_name }} · <a href="{{ manage_url }}" style="color:#78716c;">Manage or cancel your subscription</a>
    · <a href="{{ unsubscribe_url }}" style="color:#78716c;">Unsubscribe</a>
    · <a href="{{ privacy_url }}" style="color:#78716c;">Privacy</a>
  </p>

</div>
</body>
</html>
