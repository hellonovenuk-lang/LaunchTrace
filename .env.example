# LaunchTrace environment configuration
#
# Copy this file to .env and fill in the values you have. Nothing here is
# required to run the smoke test or the test suite -- every integration has a
# working offline fallback. See HANDOFF.md for how to obtain each credential.
#
# NEVER commit a filled-in .env file.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=development
SITE_URL=http://localhost:8000
ADMIN_EMAIL=
LOG_LEVEL=INFO
# console (readable) or json (for a log aggregator)
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Delivery safety
# ---------------------------------------------------------------------------
# review    = a run must be approved before anything is emailed (default; keep
#             this until you have reviewed several weeks of output)
# automatic = completed runs are delivered without manual approval
SEND_MODE=review

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty to use a local SQLite file at data/local/launchtrace.sqlite.
# For Supabase use the "Connection string" from Project settings -> Database.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# UKIPO journal ingest
# ---------------------------------------------------------------------------
# ukipo_http = live weekly journal from ipo.gov.uk (the production route)
# open_data  = the official IPO Open Data release, sliced into weeks
# local      = journal files you downloaded by hand into JOURNAL_LOCAL_DIR
# fixture    = test data
JOURNAL_SOURCE=ukipo_http
UKIPO_JOURNAL_BASE_URL=https://www.ipo.gov.uk/t-tmj/tm-journals
UKIPO_JOURNAL_INDEX_URL=https://www.ipo.gov.uk/t-tmj.htm
UKIPO_USER_AGENT=LaunchTrace/0.1 (+https://launchtrace.co.uk; weekly trade marks journal ingest)
UKIPO_REQUEST_TIMEOUT_SECONDS=120
UKIPO_MAX_RETRIES=4
JOURNAL_LOCAL_DIR=
CACHE_DIR=data/cache
KEEP_RAW_JOURNAL_FILES=false

# ---------------------------------------------------------------------------
# Companies House
# ---------------------------------------------------------------------------
# api     = the official REST API (needs a free key)
# bulk    = the free monthly bulk snapshot, indexed locally (no key needed)
# fixture = test data
# auto    = api if a key is set, else bulk if an index exists, else nothing
COMPANY_REGISTRY_PROVIDER=auto
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk
COMPANIES_HOUSE_BULK_INDEX=data/companies_house/ch_index.sqlite
COMPANIES_HOUSE_BULK_URL=https://download.companieshouse.gov.uk/en_output.html

# ---------------------------------------------------------------------------
# LLM classification (optional; the pipeline runs rule-only without it)
# ---------------------------------------------------------------------------
# anthropic | openai | none
LLM_PROVIDER=none
LLM_API_KEY=
# Use a low-cost model: this runs against every qualified candidate.
LLM_MODEL=claude-haiku-4-5-20251001
LLM_BASE_URL=
LLM_MAX_CANDIDATES_PER_RUN=400
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Web enrichment (this is what unlocks the HIGH score band)
# ---------------------------------------------------------------------------
# tavily | serper | brave | fixture | none
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_MAX_CANDIDATES_PER_RUN=150
SEARCH_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Email (Resend). Without a key, email is rendered to reports/outbox/ instead.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=LaunchTrace <feed@launchtrace.co.uk>
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Stripe (test mode first: keys starting sk_test_ / pk_test_)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDING_PRICE_ID=
STRIPE_STANDARD_PRICE_ID=

# ---------------------------------------------------------------------------
# Operator view at /admin. Leave empty to disable it entirely.
# ---------------------------------------------------------------------------
ADMIN_TOKEN=
